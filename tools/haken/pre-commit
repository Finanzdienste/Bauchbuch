#!/usr/bin/env python3
"""Lokaler Haken vor jedem Commit: nichts Persoenliches ins oeffentliche Repository.

INSTALLIEREN (einmal je Arbeitskopie, wird nicht mit eingecheckt):

    cp tools/haken/pre-commit tools/haken/commit-msg .git/hooks/
    chmod +x .git/hooks/pre-commit .git/hooks/commit-msg

WARUM

Das Repository ist oeffentlich, die App ist allgemein gebaut. Was nicht
hineingehoert - Namen, Angaben, die auf einen bestimmten Menschen zeigen -,
steht in einer Sperrliste, die NUR auf dem eigenen Rechner liegt:

    ~/.config/bodycheck/verboten.txt
    (anderer Ort: Umgebungsvariable BODYCHECK_VERBOTEN)

Jede Zeile dort ist ein regulaerer Ausdruck, gross und klein egal. Leere
Zeilen und Zeilen, die mit # beginnen, zaehlen nicht. Fehlt die Datei, tut
der Haken nichts - auf einem fremden Rechner und in CI gibt es sie nicht,
und dort prueft tools/pruefung/allgemein.py, was sich ohne Liste pruefen
laesst.

Geprueft werden nur die HINZUGEFUEGTEN Zeilen des vorgemerkten Diffs (und
die Namen der beteiligten Dateien). Was schon im Repository steht, hat
jemand anders zu entscheiden; ein Haken, der wegen einer alten Zeile jeden
Commit verweigert, wird abgeschaltet.

Die Namen kommen aus einer eigenen Abfrage, nicht aus der "+++"-Zeile des
Diffs: Die fehlt bei Binaerdateien (ein Bildschirmfoto), leeren Dateien und
reinen Umbenennungen - und gerade ein Name rutscht so leicht in einen
Dateinamen. Umlaute stehen in Diffs sonst als Oktalfolge da und treffen
kein Muster; deshalb core.quotePath=false und -z.

Die Meldung nennt Datei und Zeile, aber nie das getroffene Muster und nie
den Text: Die Sperrliste soll auch im Terminal, in Protokollen und in
Bildschirmfotos nicht auftauchen.
"""
import os
import pathlib
import re
import subprocess
import sys


def sperrliste():
    """Die Muster der lokalen Liste - oder [], wenn es keine gibt."""
    pfad = os.environ.get('BODYCHECK_VERBOTEN') or str(
        pathlib.Path.home() / '.config' / 'bodycheck' / 'verboten.txt')
    try:
        zeilen = pathlib.Path(pfad).read_text(encoding='utf-8').splitlines()
    except OSError:
        return []
    muster = []
    for nr, zeile in enumerate(zeilen, 1):
        zeile = zeile.strip()
        if not zeile or zeile.startswith('#'):
            continue
        try:
            muster.append(re.compile(zeile, re.IGNORECASE))
        except re.error:
            # Kein gueltiger Ausdruck: dann eben woertlich. Gemeldet wird nur
            # die Zeilennummer, nie der Inhalt.
            print(f'Hinweis: Zeile {nr} der Sperrliste ist kein gueltiger Ausdruck '
                  '- sie wird woertlich gesucht.', file=sys.stderr)
            muster.append(re.compile(re.escape(zeile), re.IGNORECASE))
    return muster


# Was git in einem Namen in Anfuehrungszeichen hinter \ schreibt.
ESCAPES = {ord('n'): 10, ord('t'): 9, ord('"'): 34, ord('\\'): 92, ord('a'): 7,
           ord('b'): 8, ord('f'): 12, ord('r'): 13, ord('v'): 11}


def entquoten(name):
    """Einen Namen aus dem Diff so, wie er auf der Platte heisst.

    Mit core.quotePath=false bleiben Umlaute stehen; Anfuehrungszeichen und
    Escapes setzt git aber weiter, sobald ein Name etwa einen Tabulator oder
    ein Anfuehrungszeichen enthaelt - dann auch fuer Oktalfolgen.
    """
    if not (len(name) >= 2 and name[0] == '"' and name[-1] == '"'):
        return name
    roh = name[1:-1].encode('utf-8')
    aus = bytearray()
    i = 0
    while i < len(roh):
        if roh[i] == 0x5c and i + 1 < len(roh):
            folge = roh[i + 1:i + 4]
            if len(folge) == 3 and all(0x30 <= b <= 0x37 for b in folge):
                aus.append(int(folge, 8))
                i += 4
                continue
            if roh[i + 1] in ESCAPES:
                aus.append(ESCAPES[roh[i + 1]])
                i += 2
                continue
        aus.append(roh[i])
        i += 1
    return aus.decode('utf-8', errors='replace')


def neue_namen():
    """Jeder Name, den der Commit anlegt, aendert, kopiert oder umbenennt.

    Bei einer Umbenennung das Ziel. -z liefert die Namen roh, ohne
    Anfuehrungszeichen und Oktalfolgen.
    """
    roh = subprocess.run(
        ['git', 'diff', '--cached', '--name-only', '-z', '--diff-filter=ACMRT'],
        capture_output=True, check=True,
    ).stdout
    return [n.decode('utf-8', errors='replace') for n in roh.split(b'\0') if n]


def hinzugefuegt(diff):
    """(Datei, Zeilennummer, Text) fuer jede hinzugefuegte Zeile eines Diffs."""
    datei = None
    nr = 0
    kopf = False
    for zeile in diff.splitlines():
        if zeile.startswith('diff --git '):
            kopf = True
            continue
        if kopf:
            if zeile.startswith('+++ '):
                datei = entquoten(zeile[4:])
                datei = datei[2:] if datei.startswith('b/') else datei
            if zeile.startswith('@@'):
                kopf = False
            else:
                continue
        if zeile.startswith('@@'):
            m = re.match(r'@@ -\S+ \+(\d+)', zeile)
            nr = int(m.group(1)) if m else 0
            continue
        if zeile.startswith('+'):
            yield (datei, nr, zeile[1:])
            nr += 1
        elif not zeile.startswith('-') and not zeile.startswith('\\'):
            nr += 1


def main():
    muster = sperrliste()
    if not muster:
        return 0
    treffer = []
    for name in neue_namen():
        if any(m.search(name) for m in muster) and '  ein Dateiname' not in treffer:
            treffer.append('  ein Dateiname')
    # Die Praefixe fest, damit eine eigene Einstellung (diff.noprefix,
    # diff.mnemonicPrefix) die Namen nicht verschiebt.
    diff = subprocess.run(
        ['git', '-c', 'core.quotePath=false', 'diff', '--cached', '--no-color',
         '--no-ext-diff', '--unified=0', '--src-prefix=a/', '--dst-prefix=b/'],
        capture_output=True, check=True,
    ).stdout.decode('utf-8', errors='replace')
    for datei, nr, text in hinzugefuegt(diff):
        if not any(m.search(text) for m in muster):
            continue
        # Trifft schon der Dateiname, wird auch er nicht ausgegeben - sonst
        # stuende das Getroffene doch in der Meldung.
        if any(m.search(datei or '') for m in muster):
            ort = f'  ein Dateiname, Zeile {nr}'
        else:
            ort = f'  {datei}, Zeile {nr}'
        if ort not in treffer:
            treffer.append(ort)
    if not treffer:
        return 0
    print('Commit abgebrochen: Eine hinzugefuegte Zeile trifft die lokale Sperrliste.',
          file=sys.stderr)
    print('\n'.join(treffer[:20]), file=sys.stderr)
    print('Bitte allgemein fassen - ohne Bezug auf einen bestimmten Menschen.',
          file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
